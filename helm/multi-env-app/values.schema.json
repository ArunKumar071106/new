{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "multi-env-app values",
  "type": "object",
  "required": ["environment", "replicaCount", "image", "app", "config", "service"],
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["development", "testing", "staging", "production"],
      "description": "Target environment"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "app": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      }
    },
    "config": {
      "type": "object",
      "required": ["LOG_LEVEL", "DEBUG_MODE"],
      "properties": {
        "LOG_LEVEL": { "type": "string", "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"] },
        "DEBUG_MODE": { "type": "string", "enum": ["true", "false"] },
        "FEATURE_BETA_BANNER": { "type": "string", "enum": ["true", "false"] },
        "MAX_CONNECTIONS": { "type": "string", "pattern": "^[0-9]+$" },
        "CACHE_TTL_SECONDS": { "type": "string", "pattern": "^[0-9]+$" }
      },
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "not": {
        "anyOf": [
          { "required": ["SECRET_KEY"] },
          { "required": ["PASSWORD"] },
          { "required": ["DB_PASSWORD"] },
          { "required": ["API_TOKEN"] }
        ]
      }
    },
    "existingSecret": { "type": "string" },
    "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": {
          "oneOf": [
            { "type": "string", "maxLength": 0 },
            { "type": "integer", "minimum": 30000, "maximum": 32767 }
          ]
        }
      }
    },
    "tests": {
      "type": "object",
      "properties": { "image": { "type": "string", "minLength": 1 } }
    }
  }
}
